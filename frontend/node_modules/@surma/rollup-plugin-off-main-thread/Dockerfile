# Stage 1: Build React frontend
FROM node:18 AS frontend-build

WORKDIR /app/frontend

# Copy package files and install dependencies
COPY frontend/package*.json ./
RUN npm install --legacy-peer-deps

# Copy frontend source code
COPY frontend/ ./

# Make binaries executable
RUN chmod -R +x node_modules/.bin/

# Build React app
RUN npm run build

# Debug: ensure build exists
RUN ls -la build/

# Stage 2: Build Spring Boot backend
FROM eclipse-temurin:17-jre

WORKDIR /app

# Copy Maven wrapper & pom
COPY mvnw .
COPY .mvn .mvn
COPY pom.xml .

# Make mvnw executable
RUN chmod +x mvnw

# Pre-download dependencies
RUN ./mvnw dependency:go-offline -B

# Copy backend source
COPY src ./src

# Copy frontend build contents into Spring Boot static folder
COPY --from=frontend-build /app/frontend/build/ src/main/resources/static/

# Debug: ensure static folder has index.html
RUN ls -la src/main/resources/static/

# Build Spring Boot app
RUN ./mvnw clean package -DskipTests

EXPOSE 8080

CMD ["java", "-jar", "target/POCAS-0.0.1-SNAPSHOT.jar"]